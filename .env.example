# Neon Postgres connection string. Copy this file to .env and fill it in locally.
# Never commit real credentials.
DATABASE_URL=

# WhatsApp number used to build RSVP / chat links (digits only, country code included, no "+").
# Server-side only. If unset, RSVP and WhatsApp buttons are not rendered.
WHATSAPP_NUMBER=

# Public contact email used for the mailto: link on /contact (server-side only).
# If unset or malformed, the email channel is not rendered.
CONTACT_EMAIL=

# ImageKit (image storage, CDN and transforms). All server-side only; leave empty until you have an
# ImageKit account. Find all three in the ImageKit dashboard (Developer options / URL endpoints).
# IMAGEKIT_URL_ENDPOINT is where images are served from, e.g. https://ik.imagekit.io/<your_id>.
# Until IMAGEKIT_PUBLIC_KEY and IMAGEKIT_PRIVATE_KEY are set, /api/imagekit-auth answers 503 and
# uploads are disabled. That route is admin-only (proxy.js: Clerk sign-in + ADMIN_ALLOWED_EMAILS).
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Clerk (authentication for /admin). Use a DEVELOPMENT instance's keys locally (Clerk dashboard ->
# API keys). Set both BEFORE `next build`: the publishable key is inlined at build time. Until both are
# set, the public site works normally and /admin stays closed (503). Real keys are the owner's to supply.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Who may enter /admin: a comma-separated list of email addresses, e.g. "a@example.org,b@example.org".
# Exact match, case-insensitive, and only the account's VERIFIED PRIMARY email counts. No wildcards or
# domains. Being signed in to Clerk is not enough. Empty or unset = nobody can enter (fails closed).
ADMIN_ALLOWED_EMAILS=
