# Neon Postgres connection string. Copy this file to .env and fill it in locally.
# Never commit real credentials.
DATABASE_URL=

# WhatsApp number used to build RSVP / chat links (digits only, country code included, no "+").
# Server-side only. If unset, RSVP and WhatsApp buttons are not rendered.
WHATSAPP_NUMBER=

# Public contact email used for the mailto: link on /contact (server-side only).
# If unset or malformed, the email channel is not rendered.
CONTACT_EMAIL=

# ImageKit (image storage, CDN and transforms). All server-side only; leave empty until you have an
# ImageKit account. Find all three in the ImageKit dashboard (Developer options / URL endpoints).
# IMAGEKIT_URL_ENDPOINT is where images are served from, e.g. https://ik.imagekit.io/<your_id>.
# Until IMAGEKIT_PUBLIC_KEY and IMAGEKIT_PRIVATE_KEY are set, /api/imagekit-auth answers 503 and
# uploads are disabled. Do NOT set the private key in a deployed environment before the upload-auth
# route requires an admin (Phase 10/11): it currently has no authentication.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
