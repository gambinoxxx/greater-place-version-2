 }
+
+/*
+  Homepage "Supported by" marquee (components/SponsorMarquee.jsx). The track holds the logo list twice,
+  so translating it by -50% lands exactly on the start of the second copy and the loop has no jump.
+  Paused while a pointer or keyboard focus is on it, and replaced by a still, wrapping row for anyone
+  who asks for reduced motion (WCAG 2.2.2: moving content that runs over 5s must be stoppable).
+*/
+@keyframes gp-marquee {
+  to {
+    transform: translateX(-50%);
+  }
+}
+.gp-marquee-track {
+  display: flex;
+  width: max-content;
+  align-items: center;
+  animation: gp-marquee 40s linear infinite;
+}
+.gp-marquee:hover .gp-marquee-track,
+.gp-marquee:focus-within .gp-marquee-track {
+  animation-play-state: paused;
+}
+@media (prefers-reduced-motion: reduce) {
+  .gp-marquee-track {
+    animation: none;
+    width: auto;
+    flex-wrap: wrap;
+    justify-content: center;
+    row-gap: 1.5rem;
+  }
+  .gp-marquee-dup {
+    display: none;
+  }
+}
